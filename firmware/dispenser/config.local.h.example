// config.local.h.example
//
// Copy this file to config.local.h and customize with your credentials
// config.local.h is ignored by git and won't be committed

#ifndef CONFIG_LOCAL_H
#define CONFIG_LOCAL_H

// WiFi Configuration
#define WIFI_SSID "some_ssid"
#define WIFI_PASSWORD "secret"
#define STATIC_IP IPAddress(192, 168, 188, 244)
#define GATEWAY IPAddress(192, 168, 188, 1)
#define SUBNET IPAddress(255, 255, 255, 0)

// The shared signing secret (issue #8).  It never leaves the two devices:
// requests carry a signature computed with it, never the key itself.  The
// same value goes into the terminal's configuration.
#define SIGNING_KEY "your-shared-signing-secret-here"

#endif
